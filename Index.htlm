<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#050505" id="themeColorMeta">
  <title>Star Shops | v1.0 Master Engine</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <!-- Leaflet CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; -webkit-tap-highlight-color: transparent; }
    
    html, body { 
      width: 100%; 
      min-height: 100vh; 
      background-color: #030303; 
      color: #FFFFFF; 
      overflow-x: hidden; 
      display: flex; 
      justify-content: center; 
      transition: background 0.3s, color 0.3s; 
    }
    
    html.white-mode, body.white-mode { background-color: #F8F9FA !important; color: #111827 !important; }

    .device-shell { 
      width: 100%; 
      max-width: 480px; 
      min-height: 100vh; 
      background-color: #050505; 
      color: #FFFFFF; 
      position: relative; 
      display: flex; 
      flex-direction: column; 
      padding-bottom: 85px; 
      border-left: 1px solid rgba(212,175,55,0.2); 
      border-right: 1px solid rgba(212,175,55,0.2); 
      transition: all 0.3s ease; 
    }

    /* FULL PAGE VELVET WHITE THEME STYLING */
    .device-shell.white-mode { background-color: #F8F9FA !important; color: #111827 !important; }
    .device-shell.white-mode .top-header { background: rgba(255, 255, 255, 0.95) !important; border-bottom: 1px solid rgba(0, 0, 0, 0.1) !important; }
    .device-shell.white-mode .brand-title { background: linear-gradient(to right, #9A3412, #C2410C) !important; -webkit-background-clip: text !important; -webkit-text-fill-color: transparent !important; }
    .device-shell.white-mode .google-search-bar { background: #FFFFFF !important; border: 1px solid #D1D5DB !important; box-shadow: 0 4px 15px rgba(0,0,0,0.05) !important; }
    .device-shell.white-mode .google-search-bar input { color: #111827 !important; }
    .device-shell.white-mode .google-search-bar input::placeholder { color: #9CA3AF !important; }
    .device-shell.white-mode .category-pill { background: #FFFFFF !important; border: 1px solid #D1D5DB !important; color: #374151 !important; }
    .device-shell.white-mode .category-pill.active { background: #111827 !important; color: #FFFFFF !important; border: none !important; }
    .device-shell.white-mode .merchant-card { background: #FFFFFF !important; border: 1px solid #E5E7EB !important; box-shadow: 0 4px 15px rgba(0,0,0,0.04) !important; }
    .device-shell.white-mode .store-title { color: #111827 !important; -webkit-text-fill-color: #111827 !important; }
    .device-shell.white-mode .store-address { color: #6B7280 !important; }
    .device-shell.white-mode .google-sleek-nav { background: rgba(255, 255, 255, 0.95) !important; border: 1px solid rgba(0, 0, 0, 0.1) !important; box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important; }
    .device-shell.white-mode .sleek-nav-item { color: #6B7280 !important; }
    .device-shell.white-mode .sleek-nav-item.active { color: #FFFFFF !important; background: #111827 !important; }
    .device-shell.white-mode .header-location-badge { background: #F3F4F6 !important; border: 1px solid #D1D5DB !important; color: #374151 !important; }
    .device-shell.white-mode .theme-toggle-btn { background: #F3F4F6 !important; border: 1px solid #D1D5DB !important; color: #374151 !important; }
    .device-shell.white-mode .drawer-content { background: #FFFFFF !important; color: #111827 !important; }
    .device-shell.white-mode .drawer-item { background: #F3F4F6 !important; color: #111827 !important; border: 1px solid #D1D5DB !important; }

    /* Professional Aligned Header Styles */
    .top-header { background: rgba(10, 10, 10, 0.95); backdrop-filter: blur(20px); padding: 10px 16px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(212, 175, 55, 0.25); position: sticky; top: 0; z-index: 40; width: 100%; }
    
    .header-left-group { display: flex; align-items: center; gap: 10px; }
    
    .burger-btn { background: transparent; border: none; cursor: pointer; display: flex; flex-direction: column; justify-content: space-between; width: 22px; height: 16px; padding: 0; }
    .burger-line { width: 100%; height: 2.5px; background-color: #FCF6BA; border-radius: 2px; }

    .brand-container { display: flex; flex-direction: column; justify-content: center; }
    .brand-title { font-size: 15px; font-weight: 900; letter-spacing: 1px; background: linear-gradient(to right, #BF953F, #FCF6BA, #B38728, #FBF5B7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1.1; }

    /* Header Actions */
    .header-actions { display: flex; align-items: center; gap: 6px; }
    .theme-toggle-btn { background: #121212; border: 1px solid rgba(212,175,55,0.4); color: #FCF6BA; padding: 5px 10px; border-radius: 20px; font-size: 11px; font-weight: 800; cursor: pointer; white-space: nowrap; }
    .header-location-badge { font-size: 11px; color: #FCF6BA; background: #111; padding: 5px 10px; border-radius: 20px; border: 1px solid rgba(212,175,55,0.3); white-space: nowrap; cursor: pointer; }

    /* Google Style Search Bar */
    .google-search-bar { margin: 10px 16px 6px 16px; background: #121212; border: 1px solid rgba(212, 175, 55, 0.35); border-radius: 28px; padding: 12px 18px; display: flex; align-items: center; gap: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.5); }
    .google-search-bar input { border: none; outline: none; width: 100%; font-size: 14px; color: inherit; background: transparent; }
    .google-search-bar input::placeholder { color: #757575; }

    /* Dynamic Category Pills Bar */
    .categories-pills-bar { display: flex; gap: 8px; padding: 4px 16px 10px 16px; overflow-x: auto; scrollbar-width: none; width: 100%; min-height: 44px; align-items: center; }
    .categories-pills-bar::-webkit-scrollbar { display: none; }
    .category-pill { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; background: #121212; border: 1px solid rgba(212,175,55,0.3); color: #FCF6BA; padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 800; cursor: pointer; white-space: nowrap; height: 32px; }
    .category-pill.active { background: linear-gradient(to right, #BF953F, #FCF6BA); color: #050505; border: none; }

    .tab-screen { display: none; padding: 0 16px 16px 16px; width: 100%; }
    .tab-screen.active { display: block; }
    .tab-screen#tab-map { padding: 0 !important; height: calc(100vh - 65px); display: flex; flex-direction: column; }

    /* Clean Merchant Card */
    .merchant-card { background: #0A0A0A; border-radius: 16px; border: 1px solid rgba(212, 175, 55, 0.3); overflow: hidden; margin-bottom: 14px; box-shadow: 0 4px 15px rgba(0,0,0,0.4); cursor: pointer; transition: transform 0.2s; }
    .merchant-card:active { transform: scale(0.98); }
    .card-banner { height: 140px; background: #111; position: relative; width: 100%; }
    .card-banner img { width: 100%; height: 100%; object-fit: cover; }
    .card-body { padding: 14px; }
    
    .store-title-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 4px; width: 100%; }
    .store-title { font-size: 16px; font-weight: 900; background: linear-gradient(to right, #FCF6BA, #B38728); -webkit-background-clip: text; -webkit-text-fill-color: transparent; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-grow: 1; }
    
    .star-merchant-badge { flex-shrink: 0; display: inline-flex; align-items: center; gap: 3px; background: linear-gradient(135deg, #BF953F, #FCF6BA, #B38728); color: #030303; font-size: 9px; font-weight: 900; padding: 3px 8px; border-radius: 12px; box-shadow: 0 2px 8px rgba(212,175,55,0.4); text-transform: uppercase; letter-spacing: 0.5px; }
    .store-address { font-size: 12px; color: #9CA3AF; }

    /* Full Screen Map Container */
    #mapContainer { width: 100%; height: 100% !important; flex-grow: 1; background: #111; position: relative; border-radius: 0 !important; border: none !important; }
    .leaflet-control-attribution { display: none !important; }
    
    .map-layer-switcher { position: absolute; top: 16px; right: 16px; z-index: 1000; background: rgba(10,10,10,0.9); border: 1px solid rgba(212,175,55,0.4); border-radius: 8px; padding: 4px; display: flex; gap: 4px; }
    .layer-btn { background: transparent; border: none; color: #FCF6BA; font-size: 11px; font-weight: 800; padding: 6px 10px; border-radius: 6px; cursor: pointer; }
    .layer-btn.active { background: #FCF6BA; color: #050505; }

    /* Sleek Bottom Navigation Bar */
    .google-sleek-nav { position: fixed; bottom: 10px; left: 50%; transform: translateX(-50%); width: 95%; max-width: 440px; background: rgba(18, 18, 18, 0.95); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(212,175,55,0.3); border-radius: 32px; display: flex; align-items: center; padding: 6px 10px; z-index: 9999; box-shadow: 0 10px 30px rgba(0,0,0,0.8); overflow-x: auto; scrollbar-width: none; gap: 6px; }
    .google-sleek-nav::-webkit-scrollbar { display: none; }
    
    .sleek-nav-item { flex: 0 0 auto; min-width: 75px; text-align: center; color: #9CA3AF; font-size: 10px; font-weight: 800; cursor: pointer; padding: 6px 10px; border-radius: 20px; transition: all 0.3s ease; display: flex; flex-direction: column; align-items: center; gap: 2px; }
    .sleek-nav-item.active { color: #050505; background: linear-gradient(to right, #BF953F, #FCF6BA, #B38728); box-shadow: 0 2px 10px rgba(212,175,55,0.4); }

    /* Side Drawer Menu */
    .drawer-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 99999; display: none; justify-content: flex-start; backdrop-filter: blur(5px); }
    .drawer-overlay.open { display: flex; }
    .drawer-content { width: 280px; height: 100%; background: #0A0A0A; border-right: 1px solid rgba(212,175,55,0.3); padding: 24px; display: flex; flex-direction: column; gap: 16px; }
    .drawer-item { padding: 14px; background: #121212; border: 1px solid rgba(212,175,55,0.2); border-radius: 12px; color: #FCF6BA; font-weight: 800; font-size: 14px; cursor: pointer; text-align: left; text-decoration: none; display: flex; align-items: center; gap: 10px; }

    /* Floating Window (Bottom Card Overlay) */
    .maps-bottom-card-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 999999; display: none; align-items: flex-end; backdrop-filter: blur(2px); }
    .maps-bottom-card-overlay.open { display: flex; }
    .maps-bottom-card { width: 100%; max-width: 480px; margin: 0 auto; background: #0A0A0A; border-top: 1px solid rgba(212,175,55,0.4); border-radius: 24px 24px 0 0; padding: 20px; box-shadow: 0 -10px 30px rgba(0,0,0,0.5); }
    .device-shell.white-mode .maps-bottom-card { background: #FFFFFF !important; color: #111827 !important; }
  </style>
</head>
<body>

<div class="device-shell" id="appDeviceShell">
  <header class="top-header">
    <div class="header-left-group">
      <button class="burger-btn" onclick="toggleDrawer(true)">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>
      <div class="brand-container">
        <div class="brand-title">★ STAR SHOPS</div>
      </div>
    </div>
    <div class="header-actions">
      <button class="theme-toggle-btn" onclick="toggleInterfaceTheme()" id="themeToggleBtn">☀️ व्हाइट मोड</button>
      <div class="header-location-badge" id="headerLocationText" onclick="triggerGeoFencingScan()">📍 जियो-स्कैन</div>
    </div>
  </header>

  <!-- Google Style Search Bar -->
  <div class="google-search-bar" id="topSearchBarArea">
    <span>🔍</span>
    <input type="text" id="storeSearchInput" placeholder="दुकान, एरिया या सर्विस खोजें..." oninput="filterStores(this.value)">
  </div>

  <!-- Dynamic Category Pills Bar -->
  <div class="categories-pills-bar" id="dynamicCategoriesBar">
    <div class="category-pill active" onclick="filterCategory('ALL', this)">सभी दुकानें</div>
  </div>

  <!-- TAB 1: HOME FEED -->
  <main id="tab-home" class="tab-screen active">
    <div style="font-size: 13px; font-weight: 900; margin: 4px 0 10px 0;">🏪 Explore Local Vibe (v1.0)</div>
    <div id="dynamicStoresContainer">
      <div style="text-align:center; padding:40px; color:#757575;">डेटा लोड हो रहा है...</div>
    </div>
  </main>

  <!-- TAB 2: PROVEN STABLE MAP -->
  <main id="tab-map" class="tab-screen">
    <div id="mapContainer">
      <div class="map-layer-switcher">
        <button class="layer-btn active" id="layerStandard" onclick="setMapLayer('standard')">स्ट्रीट व्यू</button>
        <button class="layer-btn" id="layerSatellite" onclick="setMapLayer('satellite')">सैटेलाइट</button>
      </div>
    </div>
  </main>

  <!-- TAB 3: LIVE NOTIFICATIONS -->
  <main id="tab-alerts" class="tab-screen">
    <div style="font-size: 13px; font-weight: 900; margin: 4px 0 10px 0;">⚡ लाइव सूचना फीड</div>
    <div id="liveAlertsContainer">
      <div style="text-align:center; padding:40px; color:#757575;">सूचनाएं लोड हो रही हैं...</div>
    </div>
  </main>

  <!-- GOOGLE MAPS STYLE SCROLLABLE BOTTOM NAVIGATION BAR -->
  <nav class="google-sleek-nav" id="bottomScrollingNav">
    <div class="sleek-nav-item active" id="navHomeBtn" onclick="switchTab('home')">
      <span>📍</span>
      <span>Explore</span>
    </div>
    <div class="sleek-nav-item" id="navMapBtn" onclick="switchTab('map')">
      <span>📌</span>
      <span>You</span>
    </div>
    <div class="sleek-nav-item" id="navAlertsBtn" onclick="switchTab('alerts')">
      <span>⚡</span>
      <span>Live Feed</span>
    </div>
    <div class="sleek-nav-item" onclick="openNetlifyForm()">
      <span>➕</span>
      <span>Add Place</span>
    </div>
    <div class="sleek-nav-item" onclick="toggleDrawer(true)">
      <span>⚙️</span>
      <span>Menu</span>
    </div>
  </nav>

  <!-- SIDE DRAWER MENU -->
  <div class="drawer-overlay" id="drawerOverlay" onclick="if(event.target === this) toggleDrawer(false)">
    <div class="drawer-content">
      <div style="font-size: 18px; font-weight: 900; margin-bottom: 10px; border-bottom: 1px solid rgba(212,175,55,0.2); padding-bottom: 10px;">⚡ नेविगेशन मेन्यू</div>
      <button onclick="openNetlifyForm()" class="drawer-item" style="background:none; border:none; color:inherit; font:inherit; cursor:pointer; width:100%;">➕ Add Place (दुकान जोड़ें)</button>
      <button class="drawer-item" onclick="toggleDrawer(false); switchTab('map');" style="width:100%;">🗺️ स्ट्रीट मैप व्यू</button>
      <button class="drawer-item" onclick="toggleDrawer(false); switchTab('alerts');" style="width:100%;">⚡ लाइव सूचना फीड</button>
      <button class="drawer-item" onclick="toggleDrawer(false); triggerGeoFencingScan();" style="width:100%;">📍 जियो-फेंसिंग स्कैन</button>
      <div style="margin-top: auto; font-size: 10px; color: #757575; text-align: center;">Star Shops Engine v1.0<br>Explore Local Vibe</div>
    </div>
  </div>

  <!-- FLOATING WINDOW (Bottom Card Overlay) -->
  <div class="maps-bottom-card-overlay" id="mapsBottomCardOverlay" onclick="if(event.target === this) closeMapsBottomCard()">
    <div class="maps-bottom-card" id="mapsBottomCardContent"></div>
  </div>
</div>

<script>
  const SUPABASE_URL = "https://gejrzpflcuvlbpedliwq.supabase.co";
  const SUPABASE_ANON_KEY = "sb_publishable_dw9J2AX0nd3SxPrRy9JGCg_YqS8ZfUF";
  const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  let liveStores = [];
  let userCurrentLocation = { lat: 28.7041, lon: 77.1025 };
  let mapInstance = null;
  let markersLayer = null;
  let routingLayer = null;
  let activeTileLayer = null;
  const defaultBanner = "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=600&q=80";

  window.addEventListener('DOMContentLoaded', async () => {
    const savedTheme = localStorage.getItem('star_theme_mode');
    if (savedTheme === 'white') {
      applyWhiteThemeUI(true);
    }
    triggerGeoFencingScan();
    await fetchApprovedStoresFromSupabase();
  });

  function triggerGeoFencingScan() {
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition((pos) => {
        userCurrentLocation.lat = pos.coords.latitude;
        userCurrentLocation.lon = pos.coords.longitude;
        document.getElementById('headerLocationText').innerText = `📍 जियो-फेंस सक्रिय`;
        if (mapInstance) {
          mapInstance.setView([userCurrentLocation.lat, userCurrentLocation.lon], 15);
        }
      }, () => {
        document.getElementById('headerLocationText').innerText = `📍 बेगमपुर, दिल्ली`;
      });
    }
  }

  function openNetlifyForm() {
    window.open('https://marchent-form.netlify.app/', '_blank');
  }

  function toggleDrawer(open) {
    const overlay = document.getElementById('drawerOverlay');
    if (open) overlay.classList.add('open');
    else overlay.classList.remove('open');
  }

  function toggleInterfaceTheme() {
    const shell = document.getElementById('appDeviceShell');
    const isWhite = shell.classList.toggle('white-mode');
    document.documentElement.classList.toggle('white-mode', isWhite);
    document.body.classList.toggle('white-mode', isWhite);
    
    localStorage.setItem('star_theme_mode', isWhite ? 'white' : 'dark');
    applyWhiteThemeUI(isWhite);
  }

  function applyWhiteThemeUI(isWhite) {
    const shell = document.getElementById('appDeviceShell');
    const btn = document.getElementById('themeToggleBtn');
    const metaTheme = document.getElementById('themeColorMeta');
    
    if (isWhite) {
      shell.classList.add('white-mode');
      document.documentElement.classList.add('white-mode');
      document.body.classList.add('white-mode');
      btn.innerHTML = "🌙 ब्लैक मोड";
      metaTheme.setAttribute('content', '#F8F9FA');
    } else {
      shell.classList.remove('white-mode');
      document.documentElement.classList.remove('white-mode');
      document.body.classList.remove('white-mode');
      btn.innerHTML = "☀️ व्हाइट मोड";
      metaTheme.setAttribute('content', '#050505');
    }
  }

  function switchTab(tabName) {
    document.querySelectorAll('.tab-screen').forEach(s => s.classList.remove('active'));
    document.getElementById(`tab-${tabName}`).classList.add('active');
    
    if (tabName === 'map') {
      document.getElementById('topSearchBarArea').style.display = 'none';
      document.getElementById('dynamicCategoriesBar').style.display = 'none';
    } else {
      document.getElementById('topSearchBarArea').style.display = 'flex';
      document.getElementById('dynamicCategoriesBar').style.display = 'flex';
    }

    document.querySelectorAll('.sleek-nav-item').forEach(n => n.classList.remove('active'));
    if(tabName === 'home') document.getElementById('navHomeBtn').classList.add('active');
    if(tabName === 'map') document.getElementById('navMapBtn').classList.add('active');
    if(tabName === 'alerts') document.getElementById('navAlertsBtn').classList.add('active');

    window.scrollTo(0,0);
    if (tabName === 'map') setTimeout(initOrRefreshMap, 10);
  }

  async function fetchApprovedStoresFromSupabase() {
    try {
      const { data, error } = await supabaseClient
        .from('merchants')
        .select('*')
        .eq('status', 'approved');

      if (error) throw error;
      liveStores = data || [];
      generateDynamicCategoryPills(liveStores);
      renderStoresFeed(liveStores);
      renderAlertsFeed(liveStores);
      if (mapInstance) initOrRefreshMap();
    } catch(err) {
      document.getElementById('dynamicStoresContainer').innerHTML = `<div style="text-align:center; padding:30px; color:#DC2626;">डेटाबेस से कनेक्ट करने में त्रुटि हुई।</div>`;
    }
  }

  function generateDynamicCategoryPills(stores) {
    const categoriesSet = new Set();
    stores.forEach(s => {
      if (s.category && s.category.trim() !== '') {
        categoriesSet.add(s.category.trim().toUpperCase());
      }
    });

    const bar = document.getElementById('dynamicCategoriesBar');
    let pillsHtml = `<div class="category-pill active" onclick="filterCategory('ALL', this)">सभी दुकानें</div>`;
    
    categoriesSet.forEach(cat => {
      pillsHtml += `<div class="category-pill" onclick="filterCategory('${cat}', this)">${cat}</div>`;
    });
    bar.innerHTML = pillsHtml;
  }

  function renderStoresFeed(stores) {
    const container = document.getElementById('dynamicStoresContainer');
    if (!stores.length) {
      container.innerHTML = `<div style="text-align:center; padding:30px; color:#757575;">डेटाबेस में कोई अप्रूव्ड दुकान उपलब्ध नहीं है।</div>`;
      return;
    }
    container.innerHTML = stores.map(store => {
      let banner = store.image_url || defaultBanner;
      return `
      <div class="merchant-card" onclick="openMapsBottomCard('${store.id}')">
        <div class="card-banner"><img src="${banner}" alt="Store"></div>
        <div class="card-body">
          <div class="store-title-row">
            <span class="store-title">${store.store_name}</span>
            <span class="star-merchant-badge">⭐ STAR MERCHANT</span>
          </div>
          <div class="store-address">📍 ${store.address || 'दिल्ली'} • <span style="color:#34D399; font-weight:800;">Open</span></div>
        </div>
      </div>`;
    }).join('');
  }

  function renderAlertsFeed(stores) {
    const container = document.getElementById('liveAlertsContainer');
    if (!stores.length) {
      container.innerHTML = `<div style="text-align:center; padding:30px; color:#757575;">कोई नई सूचना नहीं है।</div>`;
      return;
    }
    container.innerHTML = stores.map(store => `
      <div class="merchant-card" style="padding:16px; border-left: 3px solid #BF953F;" onclick="openMapsBottomCard('${store.id}')">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <div style="font-size: 12px; font-weight: 800;">✨ नई दुकान लाइव हुई!</div>
          <span class="star-merchant-badge">⭐ STAR MERCHANT</span>
        </div>
        <div style="font-size: 15px; font-weight: 900; margin-top: 4px;">${store.store_name}</div>
        <div style="font-size: 11px; margin-top: 2px;">📍 ${store.address || 'बेगमपुर, दिल्ली'}</div>
      </div>
    `).join('');
  }

  function openMapsBottomCard(storeId) {
    const store = liveStores.find(s => s.id == storeId);
    if (!store) return;
    let banner = store.image_url || defaultBanner;
    
    document.getElementById('mapsBottomCardContent').innerHTML = `
      <div style="width:40px; height:4px; background:#555; border-radius:2px; margin:0 auto 14px auto;"></div>
      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;">
        <div>
          <div style="display:flex; align-items:center; gap:8px;">
            <div style="font-size:20px; font-weight:900;" id="modalStoreName">${store.store_name}</div>
            <span class="star-merchant-badge">⭐ STAR MERCHANT</span>
          </div>
          <div style="font-size:12px; color:#34D399; font-weight:800; margin-top:2px;">${store.category || 'General'} • जियो-फेंसड</div>
        </div>
        <button onclick="closeMapsBottomCard()" style="background:none; border:none; color:inherit; font-size:20px; font-weight:bold; cursor:pointer;">✕</button>
      </div>
      <div style="font-size:12px; color:#9CA3AF; margin-bottom:12px;">Open • ${store.address || 'दिल्ली'}</div>
      
      <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:6px; margin-bottom:14px;">
        <img src="${banner}" style="width:100%; height:90px; object-fit:cover; border-radius:8px;">
        <img src="${banner}" style="width:100%; height:90px; object-fit:cover; border-radius:8px;">
        <img src="${banner}" style="width:100%; height:90px; object-fit:cover; border-radius:8px;">
      </div>

      <div style="display:flex; gap:10px;">
        <button onclick="closeMapsBottomCard(); navigateToStore('${store.id}')" style="flex:1; background:#1E3A8A; color:#60A5FA; border:1px solid #3B82F6; padding:11px; border-radius:20px; font-weight:900; font-size:13px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px;">
          🧭 Directions
        </button>
        <a href="tel:${store.phone}" style="flex:1; background:#064E3B; color:#34D399; border:1px solid #10B981; padding:11px; border-radius:20px; font-weight:900; font-size:13px; text-align:center; text-decoration:none; display:flex; align-items:center; justify-content:center; gap:6px;">
          📞 Call
        </a>
      </div>`;
    document.getElementById('mapsBottomCardOverlay').classList.add('open');
  }

  function closeMapsBottomCard() {
    document.getElementById('mapsBottomCardOverlay').classList.remove('open');
  }

  function navigateToStore(storeId) {
    switchTab('map');
    setTimeout(() => {
      const store = liveStores.find(s => s.id == storeId);
      if (store && mapInstance) {
        let lat = userCurrentLocation.lat, lon = userCurrentLocation.lon;
        if (store.location && store.location.includes(',')) {
          let parts = store.location.split(',');
          lat = parseFloat(parts[0]) || lat;
          lon = parseFloat(parts[1]) || lon;
        }

        mapInstance.setView([lat, lon], 17, { animate: true, duration: 0.5 });

        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition((pos) => {
            let uLat = pos.coords.latitude;
            let uLon = pos.coords.longitude;

            if (routingLayer) mapInstance.removeLayer(routingLayer);
            routingLayer = L.polyline([[uLat, uLon], [lat, lon]], { color: '#3B82F6', weight: 6, dashArray: '10, 10' }).addTo(mapInstance);
            mapInstance.fitBounds(routingLayer.getBounds(), { padding: [50, 50] });
          }, () => {
            alert(`नेविगेशन रूट सेट: ${store.store_name}`);
          });
        }
      }
    }, 100);
  }

  function filterStores(query) {
    const term = query.toLowerCase().trim();
    const filtered = liveStores.filter(s => s.store_name.toLowerCase().includes(term) || (s.address && s.address.toLowerCase().includes(term)) || (s.category && s.category.toLowerCase().includes(term)));
    renderStoresFeed(filtered);
  }

  function filterCategory(cat, pillEl) {
    document.querySelectorAll('.category-pill').forEach(p => p.classList.remove('active'));
    pillEl.classList.add('active');
    if (cat === 'ALL') {
      renderStoresFeed(liveStores);
    } else {
      const filtered = liveStores.filter(s => (s.category || '').toUpperCase().includes(cat));
      renderStoresFeed(filtered);
    }
  }

  function initOrRefreshMap() {
    if (!mapInstance) {
      mapInstance = L.map('mapContainer', { zoomControl: false, preferCanvas: true }).setView([userCurrentLocation.lat, userCurrentLocation.lon], 14);
      L.control.zoom({ position: 'topleft' }).addTo(mapInstance);
      
      activeTileLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '' });
      activeTileLayer.addTo(mapInstance);
      markersLayer = L.layerGroup().addTo(mapInstance);
    } else {
      mapInstance.invalidateSize();
    }

    markersLayer.clearLayers();
    let latLngs = [];

    liveStores.forEach(store => {
      let lat = userCurrentLocation.lat + (Math.random() - 0.5) * 0.02;
      let lon = userCurrentLocation.lon + (Math.random() - 0.5) * 0.02;
      
      if (store.location && store.location.includes(',')) {
        let parts = store.location.split(',');
        lat = parseFloat(parts[0]) || lat;
        lon = parseFloat(parts[1]) || lon;
      }

      latLngs.push([lat, lon]);

      const marker = L.marker([lat, lon]);
      marker.bindPopup(`<b style="color:#000;">${store.store_name}</b><br><span style="color:#333;">⭐ Star Merchant</span><br><button onclick="openMapsBottomCard('${store.id}')" style="background:#2563EB; color:#fff; border:none; padding:5px 10px; border-radius:6px; font-weight:bold; margin-top:4px; cursor:pointer;">🧭 डिटेल्स देखें</button>`);

      marker.on('dblclick', (e) => {
        L.DomEvent.stopPropagation(e);
        mapInstance.setView([lat, lon], 18, { animate: true, duration: 0.6 });
        openMapsBottomCard(store.id);
      });

      markersLayer.addLayer(marker);
    });

    if (latLngs.length > 0 && mapInstance) {
      const bounds = L.latLngBounds(latLngs);
      mapInstance.fitBounds(bounds, { padding: [60, 60], maxZoom: 15 });
    }
  }

  function setMapLayer(type) {
    document.getElementById('layerStandard').classList.remove('active');
    document.getElementById('layerSatellite').classList.remove('active');

    if (activeTileLayer) mapInstance.removeLayer(activeTileLayer);

    if (type === 'standard') {
      document.getElementById('layerStandard').classList.add('active');
      activeTileLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '' });
    } else if (type === 'satellite') {
      document.getElementById('layerSatellite').classList.add('active');
      activeTileLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, attribution: '' });
    }
    activeTileLayer.addTo(mapInstance);
  }
</script>
</body>
</html>
